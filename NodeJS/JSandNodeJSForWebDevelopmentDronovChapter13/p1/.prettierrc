{ 
      "tabWidth": 3, 
   "endOfLine": "lf", 
   "printWidth": 80, 
   "semi": true, 
   "singleQuote": true, 
   "useTabs": false, 
   "quoteProps": "as-needed", 
   "bracketSpacing": true, 
   "arrowParens": "avoid", 
   "requirePragma": false, 
   "insertPragma": false, 
   "trailingComma": "none", 
   "htmlWhitespaceSensitivity": "css", 
   "proseWrap": "preserve", 
   "jsxBracketSameLine": false, 
   "jsxSingleQuote": false, 
   "vueIndentScriptAndStyle": false, 
   "overrides": [ 
  { 
  "files": ["*.html", "*.css", "*.scss"], 
  "options": { 
  "tabWidth": 2 
  } 
  } 
] 
}
