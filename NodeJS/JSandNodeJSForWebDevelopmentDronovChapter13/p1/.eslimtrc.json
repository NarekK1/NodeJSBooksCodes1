{
    "extends": ["airbnb-base", "prettier"],
    "plugins": ["prettier"],
    "env": {
        "es6": true,
        "commonjs": true,
        "node": true
    },
    "rules": {
        "prettier/prettier": "error",
        "no-plusplus": "off",
        "prefer-const": "off",
        "no-unused-vars": ["warn", { "argsIgnorePattern": "val|req|res" }],
        "strict": "off",
        "semi": "error",
        "no-console": "off",
        "max-len": ["error", { "code": 80, "ignoreUrls": true }],
        "quotes": [
            "error",
            "single",
            { "avoidEscape": true, "allowTemplateLiterals": false }
        ]
    }

}