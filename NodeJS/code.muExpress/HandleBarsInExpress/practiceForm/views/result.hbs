<div>
 {{!-- Converted celsius to fahrenheit is: {{fahrenheit}} --}}
 {{!-- The factorial of {{number}} is: {{result}} --}}
 {{!-- The divisors of {{number}} are: {{divisors}} --}}
 {{!-- The divisors of {{num1}} and {{num2}} are: {{divisors}} --}}
 {{!-- The triangle of Pythagorean theorem  {{num1}}, {{num2}} and {{num3}} is: {{result}} --}}
 {{!-- Days difference between {{daysDifference}} is {{inputDate}} --}}
 {{!-- Words count of the text is: {{wordCount}} symbol count of the text is: {{symbolCount}} --}}
 {{!-- <h2>Input</h2>
	<pre style="white-space:pre-wrap; background:#f7f7f7; padding:10px; border-radius:4px">{{inputText}}</pre>

	<p>Total symbols: {{total}}</p>

	{{#if symbols}}
		<h3>Symbol percentages</h3>
		<table border="1" cellpadding="6" cellspacing="0">
			<thead>
				<tr>
					<th>Symbol</th>
					<th>Count</th>
					<th>Percentage</th>
				</tr>
			</thead>
			<tbody>
				{{#each symbols}}
					<tr>
						<td>{{label}}</td>
						<td>{{count}}</td>
						<td>{{percentage}}%</td>
					</tr>
				{{/each}}
			</tbody>
		</table>
	{{else}}
		<p>No text provided.</p>
	{{/if}} --}}
    {{result}}
</div>